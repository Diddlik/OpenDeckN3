{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDeckN3",
  "identifier": "de.opendeckn3.app",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenDeckN3",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OpenDeckN3",
    "homepage": "https://github.com/Diddlik/OpenDeckN3",
    "category": "Utility",
    "shortDescription": "Steuer-Software für den TreasLin N3",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../plugins/examples/": "plugins/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
